# Cuevia frontend — copy to .env.local. Only PUBLIC values belong here.
# Never put AI_SERVICE_TOKEN, Gemma/search keys or Firebase service-account JSON in this file.

# Public backend API (the browser never talks to the private AI service).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public Firebase web-app config (Firebase console -> Project settings -> Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Show "Sign in with Google" only if the provider is enabled in Firebase Auth.
VITE_FIREBASE_GOOGLE_ENABLED=false

# Development only: synthetic in-browser HTTP transport (src/dev/). Default false.
# Never enable for a real event. `npm run dev:mock` sets this via .env.mock.
VITE_USE_MOCKS=false
