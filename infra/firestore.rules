rules_version = '2';
// v1: browsers talk only to the public REST API. The backend uses the Admin SDK (which bypasses
// these rules and enforces authorization in code). Deny every direct client read/write so private
// documents (private_profiles, question_judgments, snapshots, tasks) are never reachable from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
