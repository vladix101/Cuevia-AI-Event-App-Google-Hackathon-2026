# Cuevia AI service (ai/) - server-only settings. Copy to ai/.env; never commit the real file.

# Shared secret the backend sends as X-Internal-Token. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=

# Text inference provider: google | openai_compatible
#  - google (default, verified 2026-10-11): Google Generative Language API, hosted Gemma 4.
#    Models visible to an AI Studio key: gemma-4-26b-a4b-it (recommended), gemma-4-31b-it.
#  - openai_compatible: an OpenAI-compatible server serving Gemma (verified: local Ollama /v1)
GEMMA_PROVIDER=google
GEMMA_API_KEY=
# Must be a Gemma-family id; anything else is refused.
GEMMA_MODEL=gemma-4-26b-a4b-it
# openai_compatible only, e.g. local Ollama: http://localhost:11434/v1
GEMMA_API_BASE_URL=

# Audio transcription: disabled | openai_compatible (separate audio-capable Gemma endpoint)
# Hosted Gemma 4 on the Google API rejects audio ("Audio input modality is not enabled for this
# model"), so audio needs a separate endpoint, e.g. Ollama gemma4:e2b / gemma4:e4b. Example:
#   GEMMA_ASR_MODE=openai_compatible  GEMMA_ASR_MODEL=gemma4:e2b  GEMMA_ASR_ENDPOINT=http://localhost:11434/v1
GEMMA_ASR_MODE=disabled
GEMMA_ASR_MODEL=
GEMMA_ASR_ENDPOINT=
GEMMA_ASR_API_KEY=

# Not used by the current providers (Ollama pulls gemma4 without it). Reserved for a future
# Hugging Face transformers Gemma provider that would need gated weights.
HF_TOKEN=

# Optional: raw Brave Web Search for /explain sources. Unset -> provided/general mode only.
BRAVE_SEARCH_API_KEY=

# Optional tuning (defaults shown)
# GEMMA_TIMEOUT_SECONDS=120
# GEMMA_MAX_OUTPUT_TOKENS=1024
# GEMMA_MAX_CONCURRENCY=2
# GEMMA_JSON_MODE=true          # google: responseMimeType=application/json; openai_compatible: response_format
# GEMMA_DISABLE_THINKING=true   # google: thinkingLevel=minimal; openai_compatible: reasoning_effort=none
# GEMMA_ASR_MAX_SECONDS=30
# GEMMA_ASR_MAX_BYTES=10485760
# USE_SYSTEM_TRUST_STORE=true   # verify TLS against the OS trust store (truststore)
# AI_BIND_HOST=127.0.0.1        # Docker image sets 0.0.0.0
# LOG_LEVEL=INFO
