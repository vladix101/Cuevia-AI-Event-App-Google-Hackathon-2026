# --- Firebase (backend owns all Firestore access via Admin SDK; files are stored in Firestore, no Storage bucket) ---
FIREBASE_PROJECT_ID=demo-cuevia
# Service-account JSON path for a real project. Leave empty for emulators or Cloud Run ADC.
# Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=
# Emulators (local development). Remove these lines to talk to a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Private AI service (no Gemma provider key here; it lives only in ai/) ---
AI_SERVICE_URL=http://localhost:8001/internal/v1
AI_SERVICE_TOKEN=change-me-shared-with-ai-service
AI_TIMEOUT_SECONDS=60

# --- Public API ---
CORS_ORIGINS=http://localhost:5173
MAX_CV_BYTES=5242880
MAX_CHUNK_BYTES=2097152
SAMPLE_RATE_HZ=16000
CHUNK_SECONDS=5
CLOCK_SKEW_MS=15000
RATE_LIMIT_PER_MINUTE=120

# --- Deterministic scoring policy (prototype gate) ---
POLICY_VERSION=policy-v1
QUESTION_LIMIT=3
CONTEXT_WINDOW_SECONDS=180
GATE_MIN_RELEVANCE=6
TOPIC_BONUS_CAP=10
TOP_K=5

# --- Background worker (Firestore-backed queue, lease-based recovery) ---
WORKER_ENABLED=true
WORKER_POLL_SECONDS=15
TASK_LEASE_SECONDS=120
TASK_MAX_ATTEMPTS=5
JUDGE_CONTEXT_WAIT_SECONDS=60
